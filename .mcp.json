{
  "mcpServers": {
    "devenv": {
      "type": "stdio",
      "command": "devenv",
      "args": [
        "mcp"
      ],
      "timeout": 60000
    },
    "winboat": {
      "type": "stdio",
      "command": "wb",
      "args": [
        "--workspace",
        ".",
        "mcp"
      ],
      "timeout": 60000
    }
  }
}
