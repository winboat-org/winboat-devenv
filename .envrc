#!/usr/bin/env bash

eval "$(devenv direnvrc)"

# Direnv/editor integration. For native shell auto-activation, see
# docs/auto-activation.md; choose one activation method per shell.
# Rebuild the exported commands when repository pins or imported modules change.
watch_file nix/*.nix
watch_file nix/commands/*.nix tools/wb/*.py tools/mcp/*.mjs config/defaults.json
watch_file nix/adapters/*.nix nix/scripts/*.py
use devenv
