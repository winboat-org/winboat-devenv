# Merge into .codex/config.toml; start Codex in this workspace.
[mcp_servers.devenv]
command = "devenv"
args = ["mcp"]

[mcp_servers.winboat]
command = "devenv"
args = ["shell", "--", "wb", "mcp"]
startup_timeout_sec = 120
tool_timeout_sec = 60

